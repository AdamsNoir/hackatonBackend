# Copy this file to ".env" and fill in your values
NODE_ENV=development
PORT=5000

# Local MongoDB, or your MongoDB Atlas connection string
MONGODB_URI="mongodb+srv://noircarlus_db_user:jaRpykFxkFdjLouG@cluster0.bvcbxmv.mongodb.net"
# Secret used to sign login tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=crypto.randomBytes(32).toString('hex') 
JWT_EXPIRES_IN=1d

# Address(es) of the frontend, separated by commas (CORS)
CLIENT_ORIGIN=http://localhost:5173

# Folder where the voice files are saved
UPLOAD_DIR=uploads

# Password hashing strength (12 is a good default; higher = slower & safer)
BCRYPT_ROUNDS=10

# Number of reverse proxies in front of the API (nginx, Render, Heroku...).
# 0 = none (local). Needed so rate limiting sees the real visitor IP.
TRUST_PROXY=0
